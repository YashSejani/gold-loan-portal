# API
PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://goldloan:goldloan@localhost:5432/goldloan
DATABASE_URL_TEST=postgresql://goldloan:goldloan@localhost:5432/goldloan_test
GOLD_RATE_24K_PAISE_PER_GRAM=700000
CORS_ORIGIN=http://localhost:5173
# LLM (OpenAI-compatible)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
# Comma-separated, best first: on a rate limit / overload the next model continues the same chat.
# (gemini-2.5-* is closed to new API keys.)
LLM_MODEL=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
EVAL_DELAY_MS=4000
# Web
VITE_API_URL=
